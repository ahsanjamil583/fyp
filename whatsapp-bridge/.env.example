BIZXUS_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Matches WHATSAPP_BRIDGE_ADMIN_KEY on the API. With it set, this bridge asks BizXusAI
# which businesses to connect, so a newly connected business pairs without editing
# this file or restarting. Without it, only the tenants listed below can pair.
BIZXUS_BRIDGE_KEY=replace_with_a_shared_bridge_key

# --- One business (simplest setup) ---
# Both values come from Dashboard > WhatsApp Agent > Refresh bridge token.
BIZXUS_TENANT_ID=PASTE_TENANT_ID_FROM_DASHBOARD
BIZXUS_WHATSAPP_BRIDGE_TOKEN=PASTE_BRIDGE_TOKEN_FROM_DASHBOARD
WHATSAPP_AUTH_PATH=.baileys_auth/default

# --- Several businesses in one bridge process ---
# Set BIZXUS_TENANTS instead of the two variables above. Each business is a separate
# linked device and needs its own QR scan; credentials are never shared between them.
# authPath is optional and defaults to .baileys_auth/<tenantId>.
# BIZXUS_TENANTS=[{"tenantId":"...","bridgeToken":"...","label":"Bonanza"},{"tenantId":"...","bridgeToken":"...","label":"Style"}]
#
# Or keep the list in a file instead of the environment:
# BIZXUS_TENANTS_FILE=./tenants.json

PORT=3005
BAILEYS_LOG_LEVEL=silent
BRIDGE_NAME=BizXusAI WhatsApp Agent
FALLBACK_REPLY=Sorry, I could not generate a response right now. The business owner has been notified.
