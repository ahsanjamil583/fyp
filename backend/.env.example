
# Phase 29 - Phone-first OTP authentication
OTP_CODE_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DEMO_CODE=123456
OTP_DEMO_MODE=false
OTP_RETURN_CODE_IN_RESPONSE=true

# Business email OTP SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bizxusai@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=bizxusai@gmail.com
SMTP_FROM_NAME=BizXusAI

# Stripe test payments
FRONTEND_BASE_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=pkr
STRIPE_SUCCESS_PATH=/customer/orders/{orderId}?payment=stripe_success
STRIPE_CANCEL_PATH=/customer/orders/{orderId}?payment=stripe_cancelled

# WhatsApp Agent
# Keep mock for local/FYP dashboard simulator. Use meta_cloud only with Meta WhatsApp Cloud API credentials.
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=bizxus-whatsapp-verify
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# Meta WhatsApp Embedded Signup - Phase A readiness
# Create these in Meta Developer Dashboard before implementing the signup flow.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_configuration_id_here
META_GRAPH_API_VERSION=v21.0
META_BUSINESS_LOGIN_REDIRECT_PATH=/dashboard/whatsapp-agent/connect/callback
BACKEND_PUBLIC_URL=https://your-ngrok-or-deployed-backend.example.com
