# BizXusAI backend environment template
# Keep local defaults here. Put real production values in Railway variables.

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Local development CORS. In Railway production set only the Vercel origin:
# CORS_ORIGINS=https://bizxusai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bizxus_ai
# Generate a private value before deploying anywhere reachable:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected when APP_ENV=production.
JWT_SECRET_KEY=replace_with_a_strong_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

DEFAULT_ADMIN_FULL_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PHONE=
DEFAULT_ADMIN_PASSWORD=

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./chroma-data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Phone-first/email OTP
OTP_CODE_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DEMO_CODE=123456
OTP_DEMO_MODE=false
OTP_RETURN_CODE_IN_RESPONSE=false

# SMTP. Use Gmail App Password, not the normal Gmail password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BizXusAI

# Frontend URL used by Stripe redirects and customer-facing links.
# Local:
FRONTEND_BASE_URL=http://localhost:5173
# Railway production:
# FRONTEND_BASE_URL=https://bizxusai.vercel.app

# Stripe test/production payment configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pkr
STRIPE_SUCCESS_PATH=/customer/orders/{orderId}?payment=stripe_success
STRIPE_CANCEL_PATH=/customer/orders/{orderId}?payment=stripe_cancelled

# WhatsApp Agent
WHATSAPP_PROVIDER=baileys
WHATSAPP_VERIFY_TOKEN=replace_with_your_webhook_verify_token
# Baileys linked-device bridge runs separately from FastAPI.
# Copy per-business bridge values from /dashboard/whatsapp-agent into whatsapp-bridge/.env.

# Backend public URL used for webhook callback generation.
# Local with tunnel:
BACKEND_PUBLIC_URL=https://your-ngrok-or-deployed-backend.example.com
# Railway production:
# BACKEND_PUBLIC_URL=https://bizxusai-production.up.railway.app

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_HTTP_URL=
SMS_SENDER_ID=BizXusAI

LOCAL_UPLOAD_DIR=./uploads
TEMP_UPLOAD_DIR=./uploads/temp
LOG_DIR=../logs
LOG_LEVEL=INFO
BACKUP_DIR=./backups
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=300
AI_DAILY_MESSAGE_CAP=300
